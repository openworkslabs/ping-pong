{
  "name": "arcade-monorepo",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "packages/site",
    "packages/games/*",
    "packages/server"
  ],
  "scripts": {
    "dev": "npm run dev:site",
    "dev:site": "npm run dev -w @arcade/site",
    "dev:ping-pong": "npm run dev -w @arcade/ping-pong",
    "dev:all": "concurrently \"npm run dev:site\" \"npm run dev:ping-pong\"",
    "build": "npm run build:site && npm run build:games",
    "build:site": "npm run build -w @arcade/site",
    "build:games": "npm run build -w @arcade/ping-pong",
    "build:ping-pong": "npm run build -w @arcade/ping-pong",
    "preview": "npm run preview -w @arcade/site",
    "server:go": "cd packages/server && go run ."
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
