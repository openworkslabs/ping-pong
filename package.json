{
  "name": "arcade-monorepo",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "packages/site",
    "packages/games/*/frontend",
    "packages/games/*/backend"
  ],
  "scripts": {
    "dev": "npm run dev:site",
    "dev:site": "npm run dev -w @arcade/site",
    "dev:ping-pong": "npm run dev -w @arcade/ping-pong-frontend",
    "dev:ping-pong-backend": "npm run start -w @arcade/ping-pong-backend",
    "dev:golf": "npm run dev -w @arcade/golf-frontend",
    "dev:golf-backend": "npm run start -w @arcade/golf-backend",
    "dev:all": "concurrently \"npm run dev:site\" \"npm run dev:ping-pong\" \"npm run dev:ping-pong-backend\"",
    "build": "npm run build:site && npm run build:games",
    "build:site": "npm run build -w @arcade/site",
    "build:games": "npm run build -w @arcade/ping-pong-frontend",
    "build:ping-pong": "npm run build -w @arcade/ping-pong-frontend",
    "build:golf": "npm run build -w @arcade/golf-frontend",
    "preview": "npm run preview -w @arcade/site",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prettier": "^3.6.2"
  }
}
